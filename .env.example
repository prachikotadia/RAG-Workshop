# Prachi RAG Workspace - Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=Prachi RAG Workspace
ENVIRONMENT=dev

# Database
# For local development with SQLite:
DATABASE_URL=sqlite:///./rag_workspace.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/rag_db
# For Docker:
# DATABASE_URL=postgresql+psycopg2://user:password@db:5432/rag_db

# Security
JWT_SECRET_KEY=your-secret-key-here-minimum-32-characters-long-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI (for embeddings and LLM)
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDINGS_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# LLM Provider Selection
# Options: openai, groq, local
LLM_PROVIDER=openai

# Groq (FREE alternative to OpenAI)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile
# Other Groq models: mixtral-8x7b, gemma2-9b

# Local LLM (LM Studio, Ollama, etc.)
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=local-model-name

# Embeddings Provider
# Options: openai, huggingface
EMBEDDINGS_PROVIDER=openai
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_CACHE_DIR=

# Vector Store
VECTORSTORE_BASE_DIR=data/vectorstores
# Options: faiss, pinecone, chroma
VECTORSTORE_PROVIDER=faiss

# Pinecone (if using Pinecone)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# Chroma (if using Chroma)
CHROMA_PERSIST_DIRECTORY=data/chroma

# Storage
STORAGE_BASE_DIR=storage
# Options: filesystem, s3
STORAGE_PROVIDER=filesystem

# AWS S3 (if using S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# CORS
CORS_ORIGINS=*

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=.pdf,.txt,.md,.markdown

# Refresh Token
REFRESH_TOKEN_EXPIRE_DAYS=30
